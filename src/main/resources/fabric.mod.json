  {
  "schemaVersion": 1,
  "id": "reliablenametags",
  "version": "${version}",
  "name": "Reliable Name Tags",
  "description": "Lets you right-click Name Tags in the air to change their name - a port of Convenient Name Tags to modern versions.",
  "authors": [
    "cassiancc",
    "Mim1q"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/reliable-name-tags",
    "sources": "https://github.com/cassiancc/ReliableNameTags",
    "issues": "https://github.com/cassiancc/ReliableNameTags/issues"
  },
  "license": "Apache 2.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "cc.cassian.reliablenametags.fabric.FabricEntrypoint"
    ]
  },
  "mixins": [
    "reliablenametags.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.8",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  },
  "recommends": {
    "mcqoy": "*"
  }
}